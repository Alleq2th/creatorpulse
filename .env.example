# ==========================================
# CreatorPulse Environment Variables
# Every value here is a placeholder. Copy to .env and fill in what you need -
# the app boots with none of them set, and GET /api/health reports which
# integrations are actually configured.
# ==========================================

# Server
PORT=3000
NODE_ENV=production

# ==========================================
# Supabase (database + auth)
# ==========================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Public anon key - used to exchange a password-recovery token for a session.
SUPABASE_ANON_KEY=your_supabase_anon_key

# ==========================================
# AI APIs
# ==========================================
GROQ_API_KEY=your_groq_api_key
HF_API_KEY=your_huggingface_api_key

# ==========================================
# News APIs
# ==========================================
NEWS_API_KEY=your_news_api_key
NEWSDATA_API_KEY=your_newsdata_api_key
CURRENTS_API_KEY=your_currents_api_key

# ==========================================
# Image APIs
# ==========================================
# Optional - without it, image generation is rate-limited to ~1 per 15s.
POLLINATIONS_KEY=your_pollinations_key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
PEXELS_API_KEY=your_pexels_api_key

# ==========================================
# Google OAuth (Calendar)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=your_google_redirect_uri

# ==========================================
# Web push (VAPID)
# Generate a keypair with: npx web-push generate-vapid-keys
# ==========================================
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# Must be a mailto: or https: URL. Contact metadata, not an identity.
VAPID_SUBJECT=mailto:noreply@creatorpulse.app

# ==========================================
# Frontend / links
# ==========================================
FRONTEND_URL=https://your-domain.com
# Password-reset return target. Defaults to FRONTEND_URL when unset.
PASSWORD_RESET_REDIRECT=https://your-domain.com

# ==========================================
# Admin
# ==========================================
ADMIN_KEY=create_a_long_random_secret_here
